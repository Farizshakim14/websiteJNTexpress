rules_version = '2';

// =========================================================================
// J&T EXPRESS — TRANSPORTATION MONITORING SYSTEM (TMS) v5
// ENTERPRISE FIRESTORE SECURITY RULES (9-ROLE RBAC & VENDOR OWNERSHIP)
// Optimized with `let` bindings & `in` sets to stay well under 1,000 AST expressions.
// =========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. HELPER FUNCTIONS: AUTHENTICATION & VERIFIED PROFILE ──────────
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Single `get()` evaluation bound via `let p` to eliminate redundant AST expansion
    function userRole() {
      let p = isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userProfile()
        : null;
      let isActive = p != null && (
        !('status' in p)
        || !(p.status in ['Nonaktif', 'NONAKTIF', 'nonaktif', 'Inactive', 'INACTIVE'])
      );
      return isActive && ('role' in p) ? p.role : 'NONE';
    }

    // ── 2. OFFICIAL 9 ROLES DEFINITIONS (J&T TMS RBAC MATRIX) ───────────
    // 1. DEVELOPER
    // 2. OWNER
    // 3. ADMIN
    // 4. MANAGER
    // 5. ASISTEN_MANAGER
    // 6. SUPERVISOR
    // 7. STAFF_VEHICLE_DISPATCH
    // 8. FINANCE
    // 9. VENDOR

    function isDeveloper() { return userRole() == 'DEVELOPER'; }
    function isOwner() { return userRole() == 'OWNER'; }
    function isAdmin() { return userRole() == 'ADMIN'; }
    function isManager() { return userRole() == 'MANAGER'; }
    function isAsistenManager() { return userRole() == 'ASISTEN_MANAGER'; }
    function isSupervisor() { return userRole() == 'SUPERVISOR'; }
    function isStaffDispatch() { return userRole() in ['STAFF_VEHICLE_DISPATCH', 'OPERATOR_SLA', 'OPERATOR_MONITORING']; }
    function isFinance() { return userRole() == 'FINANCE'; }
    function isVendor() { return userRole() == 'VENDOR'; }

    // ── 3. ROLE TIER GROUPINGS (SINGLE userRole() EVALUATION PER CHECK) ─
    function isTopTierAdmin() {
      return userRole() in ['DEVELOPER', 'OWNER', 'ADMIN'];
    }

    function isManagementOrSpv() {
      return userRole() in [
        'DEVELOPER',
        'OWNER',
        'ADMIN',
        'MANAGER',
        'ASISTEN_MANAGER',
        'SUPERVISOR'
      ];
    }

    function isInternalReader() {
      return userRole() in [
        'DEVELOPER',
        'OWNER',
        'ADMIN',
        'MANAGER',
        'ASISTEN_MANAGER',
        'SUPERVISOR',
        'STAFF_VEHICLE_DISPATCH',
        'OPERATOR_SLA',
        'OPERATOR_MONITORING',
        'FINANCE'
      ];
    }

    function isInternalOperationalWriter() {
      return userRole() in [
        'DEVELOPER',
        'OWNER',
        'ADMIN',
        'MANAGER',
        'ASISTEN_MANAGER',
        'SUPERVISOR',
        'STAFF_VEHICLE_DISPATCH',
        'OPERATOR_SLA',
        'OPERATOR_MONITORING'
      ];
    }

    function canDeleteOperational() {
      return isManagementOrSpv();
    }

    function canWriteMasterData() {
      return isManagementOrSpv();
    }

    // ── 4. VENDOR OWNERSHIP VALIDATION (SERVER-SIDE ENFORCED) ───────────
    // Single `let p = userProfile()` binding per call
    function isOwnVendorDoc(docData) {
      let p = isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userProfile()
        : null;
      let isActiveVendor = p != null
        && (!('status' in p) || !(p.status in ['Nonaktif', 'NONAKTIF', 'nonaktif', 'Inactive', 'INACTIVE']))
        && ('role' in p) && p.role == 'VENDOR';
      let vName = isActiveVendor && ('vendorName' in p) && p.vendorName != null
        ? p.vendorName
        : (isActiveVendor && ('vendor' in p) && p.vendor != null ? p.vendor : '');
      let vShort = isActiveVendor && ('vendorShort' in p) && p.vendorShort != null
        ? p.vendorShort
        : '';
      let docVendor = docData != null && ('vendor' in docData) && docData.vendor != null
        ? docData.vendor
        : (docData != null && ('namaVendor' in docData) && docData.namaVendor != null ? docData.namaVendor : '');
      return isActiveVendor
        && docVendor != ''
        && (
          (vName != '' && docVendor == vName)
          || (vShort != '' && docVendor == vShort)
          || (vShort != '' && docVendor.matches('.*' + vShort + '.*'))
        );
    }

    // Vendor is only allowed to update fleet position / check-in fields on monitoring_4h
    // Cannot alter SLA target, jamBerangkat, kodeTugas, or transfer trip to another vendor
    function isValidVendorMonitoringUpdate() {
      return isOwnVendorDoc(resource.data)
        && request.resource.data.kodeTugas == resource.data.kodeTugas
        && request.resource.data.vendor == resource.data.vendor
        && request.resource.data.jamBerangkat == resource.data.jamBerangkat
        && (!('targetSLAHours' in resource.data) || request.resource.data.targetSLAHours == resource.data.targetSLAHours)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'slots',
          'lastUpdateSlot',
          'lastUpdateLokasi',
          'lastUpdateTime',
          'lastUpdateBy',
          'statusPerjalanan',
          'jamSampaiAktual',
          'jamSampaiJKT999',
          'lokasiSampai',
          'catatanSampai',
          'catatan',
          'fotoSampai',
          'hasFotoSampai',
          'shiftId',
          'updatedAt'
        ]);
    }

    // Hierarchy check for User Management (Single `let r = userRole()` evaluation)
    function canManageTargetRole(actorRole, targetRole) {
      return actorRole == 'DEVELOPER'
        || (actorRole in ['OWNER', 'ADMIN'] && targetRole != 'DEVELOPER')
        || (actorRole in ['MANAGER', 'ASISTEN_MANAGER'] && targetRole in ['SUPERVISOR', 'STAFF_VEHICLE_DISPATCH', 'FINANCE', 'VENDOR'])
        || (actorRole == 'SUPERVISOR' && targetRole in ['STAFF_VEHICLE_DISPATCH', 'VENDOR']);
    }

    // ── 5. OPERATIONAL COLLECTIONS ──────────────────────────────────────

    match /incoming/{kodeTugas} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create, update: if isInternalOperationalWriter();
      allow delete: if canDeleteOperational();
    }

    match /sla_outbound/{kodeTugas} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create, update: if isInternalOperationalWriter();
      allow delete: if canDeleteOperational();
    }

    match /sla_return/{kodeTugas} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create, update: if isInternalOperationalWriter();
      allow delete: if canDeleteOperational();
    }

    match /sla_roundtrip/{kodeTugas} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create, update: if isInternalOperationalWriter();
      allow delete: if canDeleteOperational();
    }

    match /monitoring_4h/{kodeTugas} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create: if isInternalOperationalWriter();
      allow update: if isInternalOperationalWriter() || isValidVendorMonitoringUpdate();
      allow delete: if canDeleteOperational();
    }

    match /troubles/{incidentId} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create: if isInternalOperationalWriter() || isOwnVendorDoc(request.resource.data);
      allow update: if isInternalOperationalWriter();
      allow delete: if canDeleteOperational();
    }

    match /shifts/{shiftId} {
      allow read: if isInternalReader();
      allow create, update: if isInternalOperationalWriter();
      allow delete: if canDeleteOperational();
    }

    // ── 6. MASTER DATA COLLECTIONS ──────────────────────────────────────
    match /master_trips/{tripCode} {
      allow read: if isInternalReader() || isVendor();
      allow create, update, delete: if canWriteMasterData();
    }

    match /master_fleets/{platNomor} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create, update, delete: if canWriteMasterData();
    }

    match /master_vendors/{vendorId} {
      allow read: if isInternalReader() || isVendor();
      allow create, update, delete: if canWriteMasterData();
    }

    match /master_drivers/{driverId} {
      allow read: if isInternalReader() || isOwnVendorDoc(resource.data);
      allow create, update, delete: if canWriteMasterData();
    }

    match /master_reasons/{reasonId} {
      allow read: if isInternalReader() || isVendor();
      allow create, update, delete: if canWriteMasterData();
    }

    // ── 7. USER MANAGEMENT & AUTHENTICATION COLLECTIONS ─────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isManagementOrSpv()
        || (resource != null && ('uid' in resource.data) && resource.data.uid == request.auth.uid)
        || (resource != null && ('email' in resource.data) && request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );

      allow create: if isSignedIn() && (
        canManageTargetRole(userRole(), request.resource.data.role)
        || (
          request.auth.uid == userId
          && ('username' in request.resource.data)
          && exists(/databases/$(database)/documents/users/$(request.resource.data.username))
          && get(/databases/$(database)/documents/users/$(request.resource.data.username)).data.role == request.resource.data.role
        )
      );

      allow update: if isSignedIn() && (
        (
          canManageTargetRole(userRole(), resource.data.role)
          && canManageTargetRole(userRole(), request.resource.data.role)
        )
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && (!('status' in resource.data) || request.resource.data.status == resource.data.status)
          && (!('vendorName' in resource.data) || request.resource.data.vendorName == resource.data.vendorName)
          && (!('vendorShort' in resource.data) || request.resource.data.vendorShort == resource.data.vendorShort)
        )
      );

      allow delete: if isSignedIn()
        && request.auth.uid != userId
        && canManageTargetRole(userRole(), resource.data.role);
    }

    match /user_lookup/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string;
      allow delete: if isManagementOrSpv();
    }

    match /active_sessions/{username} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read: if isInternalReader();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
