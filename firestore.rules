rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role Verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        getUserData().role == role || 
        request.auth.token.role == role
      );
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isSupervisor() {
      return hasRole('SUPERVISOR');
    }

    function isOperatorSLA() {
      return hasRole('OPERATOR_SLA');
    }

    function isOperatorMonitoring() {
      return hasRole('OPERATOR_MONITORING');
    }

    // 1. INCOMING SSOT COLLECTION
    match /incoming/{kodeTugas} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor() || isOperatorSLA();
      allow delete: if isAdmin();
    }

    // 2. SLA VENDOR COLLECTIONS (Outbound, Return, Roundtrip)
    match /sla_outbound/{kodeTugas} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor() || isOperatorSLA();
      allow delete: if isAdmin();
    }

    match /sla_return/{kodeTugas} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor() || isOperatorSLA();
      allow delete: if isAdmin();
    }

    match /sla_roundtrip/{kodeTugas} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor() || isOperatorSLA();
      allow delete: if isAdmin();
    }

    // 3. MONITORING 4 JAM COLLECTION
    match /monitoring_4h/{kodeTugas} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor() || isOperatorMonitoring();
      allow delete: if isAdmin();
    }

    // 4. TROUBLE & LAKA INCIDENT COLLECTION
    match /troubles/{incidentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor() || isOperatorMonitoring();
      allow delete: if isAdmin();
    }

    // 5. SHIFT MANAGEMENT COLLECTION
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isSupervisor();
      allow delete: if isAdmin();
    }

    // 6. AUDIT LOGS (APPEND-ONLY PROTECTION: NO UPDATE / NO DELETE)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-Only protection: No modification or deletion allowed
    }

    // 7. MASTER DATA COLLECTIONS (Trips, Fleets, Drivers, Reasons)
    match /master_trips/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /master_fleets/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /master_drivers/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /master_reasons/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 8. USERS & ROLES COLLECTIONS
    match /users/{username} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /roles/{roleName} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
