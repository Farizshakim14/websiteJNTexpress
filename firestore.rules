rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // HELPER: Pastikan request memiliki Firebase Auth token yang valid.
    // ⚡ FIREBASE-ONLY MODE: Sistem login menggunakan Anonymous Auth.
    //    Role & permission dijaga di app-level (RBAC sessionStorage).
    //    Firestore rules cukup memastikan pengguna sudah terautentikasi.
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    // -------------------------------------------------------------------------
    // 1. USER MANAGEMENT (/users/{userId})
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // 2. OPERATIONAL: INCOMING & DISPATCH (/incoming/{kodeTugas})
    // -------------------------------------------------------------------------
    match /incoming/{kodeTugas} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // 3. OPERATIONAL: SLA MANAGEMENT
    // -------------------------------------------------------------------------
    match /sla_outbound/{kodeTugas} {
      allow read, write: if isAuthenticated();
    }

    match /sla_return/{kodeTugas} {
      allow read, write: if isAuthenticated();
    }

    match /sla_roundtrip/{kodeTugas} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // 4. MONITORING 4 JAM (/monitoring_4h/{kodeTugas})
    // -------------------------------------------------------------------------
    match /monitoring_4h/{kodeTugas} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // 5. TROUBLE & LAKA (/troubles/{incidentId})
    //    Delete tetap dilarang — record harus ditutup dengan status SELESAI.
    // -------------------------------------------------------------------------
    match /troubles/{incidentId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 6. SHIFT MANAGEMENT (/shifts/{shiftId})
    //    Delete dilarang — shift adalah rekam jejak operasional permanen.
    // -------------------------------------------------------------------------
    match /shifts/{shiftId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 7. MASTER DATA (Routes, Fleets, Vendors, Drivers, Reasons, SLA)
    // -------------------------------------------------------------------------
    match /master_trips/{docId}   { allow read, write: if isAuthenticated(); }
    match /master_fleets/{docId}  { allow read, write: if isAuthenticated(); }
    match /master_vendors/{docId} { allow read, write: if isAuthenticated(); }
    match /master_drivers/{docId} { allow read, write: if isAuthenticated(); }
    match /master_reasons/{docId} { allow read, write: if isAuthenticated(); }
    match /master_routes/{docId}  { allow read, write: if isAuthenticated(); }
    match /master_sla/{docId}     { allow read, write: if isAuthenticated(); }

    // -------------------------------------------------------------------------
    // 8. AUDIT LOGS — Immutable (update & delete dilarang di level rules)
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // 9. DEFAULT DENY — Semua path yang tidak terdaftar di atas ditolak.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
