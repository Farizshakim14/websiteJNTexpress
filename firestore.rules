rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. USER MANAGEMENT (/users/{userId})
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 2. OPERATIONAL: INCOMING & DISPATCH (/incoming/{kodeTugas})
    // -------------------------------------------------------------------------
    match /incoming/{kodeTugas} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 3. OPERATIONAL: SLA MANAGEMENT
    // -------------------------------------------------------------------------
    match /sla_outbound/{kodeTugas} {
      allow read, write: if true;
    }

    match /sla_return/{kodeTugas} {
      allow read, write: if true;
    }

    match /sla_roundtrip/{kodeTugas} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 4. MONITORING 4 JAM (/monitoring_4h/{kodeTugas})
    // -------------------------------------------------------------------------
    match /monitoring_4h/{kodeTugas} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 5. TROUBLE & LAKA (/troubles/{incidentId})
    // -------------------------------------------------------------------------
    match /troubles/{incidentId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 6. SHIFT MANAGEMENT (/shifts/{shiftId})
    // -------------------------------------------------------------------------
    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 7. MASTER DATA (Routes, Fleets, Vendors, Drivers, Reasons, SLA)
    // -------------------------------------------------------------------------
    match /master_trips/{docId}   { allow read, write: if true; }
    match /master_fleets/{docId}  { allow read, write: if true; }
    match /master_vendors/{docId} { allow read, write: if true; }
    match /master_drivers/{docId} { allow read, write: if true; }
    match /master_reasons/{docId} { allow read, write: if true; }
    match /master_routes/{docId}  { allow read, write: if true; }
    match /master_sla/{docId}     { allow read, write: if true; }

    // -------------------------------------------------------------------------
    // 8. AUDIT LOGS
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 9. ACTIVE SESSIONS
    // -------------------------------------------------------------------------
    match /active_sessions/{sessionKey} {
      allow read, write, delete: if true;
    }

    // -------------------------------------------------------------------------
    // 10. DEFAULT DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
